# CodeAtlas environment template. Copy to .env and fill in.
# Never commit .env; never place keys in frontend bundles or source.

# demo | enterprise
#   demo:       synthetic/public repositories only; external inference allowed.
#   enterprise: source and source-derived context stay inside the boundary.
#               An external inference endpoint fails startup (NFR-10).
CODEATLAS_PROFILE=demo

# OpenAI-compatible inference endpoint. Leave blank to run with no model:
# the platform still returns deterministic evidence and marks narrative
# explanation unavailable. It never fabricates an answer.
CODEATLAS_MODEL_BASE_URL=https://openrouter.ai/api/v1
CODEATLAS_MODEL_API_KEY=
CODEATLAS_MODEL_NAME=openai/gpt-oss-120b

CODEATLAS_DB_URL=jdbc:postgresql://localhost:55432/codeatlas
CODEATLAS_DB_USER=codeatlas
CODEATLAS_DB_PASSWORD=codeatlas

# Read-only source root containing registered assets.
CODEATLAS_SOURCE_ROOT=../demo-estate

CODEATLAS_PLATFORM_OWNER="Platform Owner"
CODEATLAS_REFRESH_CADENCE=on-demand

# Browser origins allowed to call the API (comma separated, patterns OK).
CODEATLAS_ALLOWED_ORIGINS="http://localhost:4200,https://*.trycloudflare.com"
